{
  "name": "tagshift",
  "version": "1.0.0",
  "description": "Turn a <template> into a component class: fill its slots, interpolate ${props}, update in place.",
  "keywords": [
    "template",
    "slot",
    "component",
    "dom",
    "interpolation"
  ],
  "author": "Aleksandr Ivashkin",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "happy-dom": "^21.0.1",
    "vitest": "^5.0.4"
  }
}
